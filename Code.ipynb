import pandas as pd

try:
    df_student = pd.read_csv('student_class.csv')
    df_schedule = pd.read_csv('class_schedule.csv')
    df_log = pd.read_csv('attendance_log.csv')
except FileNotFoundError:
    print("Lỗi: Vui lòng upload đủ 3 file csv (student_class.csv, class_schedule.csv, attendance_log.csv).")

df_student['student_id'] = df_student['student_id'].astype(str).str.strip().str.lower()
df_student['student_id'] = df_student['student_id'].str.replace(r'sv(\d)', r'sv_\1', regex=True)
df_student['full_name'] = df_student['full_name'].astype(str).str.strip().str.replace(r'\s+', ' ', regex=True).str.title()
df_student['class_cohort'] = df_student['class_cohort'].astype(str).str.strip().str.upper().str.replace(r'[- ]', '', regex=True)
df_schedule['class_id'] = df_schedule['class_id'].astype(str).str.strip().str.upper().str.replace('-', '_')
df_schedule['course_name'] = df_schedule['course_name'].astype(str).str.strip().str.replace(r'\s+', ' ', regex=True).str.title()

course_mapping = {
    'Lập Trình Py': 'Lap Trinh Python',
    'Lap Trinh Py': 'Lap Trinh Python',
    'Python': 'Lap Trinh Python',
    'Xstk': 'Xac Suat Thong Ke'
}
df_schedule['course_name'] = df_schedule['course_name'].replace(course_mapping)

df_schedule = df_schedule.drop_duplicates(subset=['class_id'], keep='first')

weekday_map = {
    'Thu 2': 'Monday', 'Thứ 2': 'Monday', 'Mon': 'Monday', 'Monday': 'Monday',
    'Thu 3': 'Tuesday', 'Thứ 3': 'Tuesday', 'Tue': 'Tuesday',
    'Thu 4': 'Wednesday', 'Wed': 'Wednesday',
    'Thu 5': 'Thursday', 'Thu': 'Thursday',
    'Thu 6': 'Friday', 'Fri': 'Friday',
    'Thu 7': 'Saturday', 'Sat': 'Saturday'
}
df_schedule['weekday'] = df_schedule['weekday'].astype(str).str.strip().str.title().map(lambda x: weekday_map.get(x, x))

df_log['date'] = pd.to_datetime(df_log['date'], dayfirst=True, format='mixed', errors='coerce')
df_log['student_id'] = df_log['student_id'].astype(str).str.strip().str.lower()
df_log['student_id'] = df_log['student_id'].str.replace(r'sv(\d)', r'sv_\1', regex=True)
df_log['class_id'] = df_log['class_id'].astype(str).str.strip().str.upper().str.replace('-', '_')

def normalize_status(status):
    if pd.isna(status): return "Unknown"
    s = str(status).lower().strip()
    
    mapping = {
        'co mat': 'Present', 'present': 'Present',
        'vang': 'Absent', 'absent': 'Absent',
        'di muon': 'Late', 'late': 'Late',
        'nghi phep': 'Excused', 'excused': 'Excused'
    }
    return mapping.get(s, 'Unknown')

df_log['status'] = df_log['status'].apply(normalize_status)

df_student.to_csv('clean_student_class.csv', index=False)
df_schedule.to_csv('clean_class_schedule.csv', index=False)
df_log.to_csv('clean_attendance_log.csv', index=False)
